<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Hidra.Verify</RootNamespace>
    <AssemblyName>Hidra.Verify</AssemblyName>
    <!--
      El arnes de verificacion no se publica como AOT: su unico trabajo es correr en el
      bucle interno y en CI con `dotnet run`. Se mantiene igualmente libre de reflexion
      para que IsAotCompatible siga siendo una garantia, no una excepcion.
    -->
    <PublishAot>false</PublishAot>

    <!--
      RollForward SOLO aqui y no en la aplicacion: el arnes es una herramienta interna y
      debe arrancar con cualquier runtime disponible (10 en CI, 11-rc en maquinas de
      desarrollo que aun no lo tienen), mientras que la aplicacion publicada debe exigir
      el runtime exacto para el que se probo.
    -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Hidra.Kernel/Hidra.Kernel.csproj" />
    <ProjectReference Include="../../src/Hidra.Audio/Hidra.Audio.csproj" />
  </ItemGroup>

</Project>
